# Server
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Database — Supabase "Project Settings -> Database -> Connection string" (direct connection, not the pooler)
DATABASE_URL=postgres://user:password@host:5432/postgres

# Supabase Storage — "Project Settings -> API -> service_role" key. Server-side only, never expose to the browser.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
SUPABASE_STORAGE_BUCKET=uploads

# JWT
JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

# Comma-separated emails that get auto-promoted to admin on registration/login
ADMIN_BOOTSTRAP_EMAILS=you@example.com

# Google OAuth — Google Cloud Console -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# Groq LLM — server-side only now
GROQ_API_KEY=your_groq_key
